# Copiar a .env y ajustar. NUNCA subir .env al repo.
APP_ENV=local
APP_URL=http://localhost:4200
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos (MariaDB local por socket; el usuario slm autentica por unix_socket)
DB_HOST=localhost
DB_PORT=3306
DB_SOCKET=/tmp/mysql.sock
DB_NAME=polideportivos_app
DB_USER=slm
DB_PASS=

# Polideportivo de esta instancia
POLIDEPORTIVO_ID=5
POLIDEPORTIVO_NOMBRE=Palmeras

# SMS: demo | real (real todavía no implementado)
SMS_PROVIDER=demo

# Sesiones
TOKEN_TTL_DAYS=30

# Registro / verificación
REGISTRO_TTL_MINUTES=30
CODIGO_TTL_MINUTES=10
CODIGO_MAX_INTENTOS=5
LOGIN_MAX_INTENTOS=10
LOGIN_VENTANA_MINUTOS=15
